SELECT a.account_id, a.customer_name
FROM Account a
JOIN Holding h
    ON a.account_id = h.account_id
JOIN Stock s
    ON h.exg_code = s.exg_code
    AND h.ticker = s.ticker
JOIN Company c
    ON s.company_id = c.company_id
WHERE c.sector = 'Technology'

INTERSECT

SELECT a.account_id, a.customer_name
FROM Account a
JOIN Holding h
    ON a.account_id = h.account_id
JOIN Stock s
    ON h.exg_code = s.exg_code
    AND h.ticker = s.ticker
JOIN Company c
    ON s.company_id = c.company_id
WHERE c.sector = 'Financials'

EXCEPT

SELECT a.account_id, a.customer_name
FROM Account a
JOIN Holding h
    ON a.account_id = h.account_id
JOIN Stock s
    ON h.exg_code = s.exg_code
    AND h.ticker = s.ticker
JOIN Company c
    ON s.company_id = c.company_id
WHERE c.sector = 'Energy';
